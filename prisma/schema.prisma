// O Prisma só aplica as migrations. As consultas continuam no driver pg.
// Não rode `prisma db push` nem `prisma migrate dev` nesta base:
// o schema abaixo não descreve as tabelas legadas e esses comandos tentariam alterá-las.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
