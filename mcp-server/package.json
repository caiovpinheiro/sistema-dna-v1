{
  "name": "@dnawork/mcp-server",
  "private": true,
  "version": "0.1.0",
  "description": "Gateway MCP da DNA Work: fala o protocolo MCP e repassa ao monólito (mTLS + HMAC). Sem banco de dados.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-timeout 180000 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "fastify": "^5.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
