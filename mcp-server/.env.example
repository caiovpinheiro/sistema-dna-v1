# Gateway MCP — só nomes e exemplos. Valores reais ficam nas variáveis do EasyPanel; certificados em arquivos montados.
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
MCP_PUBLIC_URL=https://mcp.dnawork.ai
MONOLITO_ISSUER_URL=
MONOLITO_INTERNAL_URL=https://nome-interno-do-monolito:3334
MONOLITO_TLS_SERVERNAME=
MCP_GATEWAY_KEY_ID=gw1
MCP_GATEWAY_SECRET=
MCP_CONTRATO=1
MCP_TLS_CA=/run/mcp-tls/ca-bundle.pem
MCP_TLS_CERT=/run/mcp-tls/gateway-mcp.cert.pem
MCP_TLS_KEY=/run/mcp-tls/gateway-mcp.key.pem
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
TRUST_PROXY=1
# Descoberta inicial de ferramentas sem login (só metadados). 0 desliga.
MCP_DESCOBERTA_PUBLICA=1
