# Copie para .env na raiz do monorepo. Nunca commitar o .env.
# Aponte somente para um PostgreSQL local ou de homologação.
# Não coloque aqui a URL, a senha ou o host da base atual.

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54330/dnawork
JWT_SECRET=troque-por-um-segredo-longo-de-pelo-menos-32-caracteres
ADMIN_EMAIL=admin@dnawork.local

# Produção: use apenas o hash. Gere com:
# npm run hash-password -- "sua-senha"
ADMIN_PASSWORD_HASH=

# Desenvolvimento local. Se o hash estiver vazio, esta senha é aceita e
# convertida para Argon2id apenas em memória, no boot.
ADMIN_PASSWORD=altere-esta-senha

PORT=3333
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Códigos confirmados na base atual em 2026-10-21.
# Contratação: 1 ativa (sem data de demissão), 2 encerrada.
# Vaga: 1 passa a ocupada no legado ao contratar; 2 acompanha contratos encerrados.
CONTRATACAO_STATUS_ATIVO=1
CONTRATACAO_STATUS_ENCERRADO=2
VAGA_STATUS_OCUPADA=1
VAGA_STATUS_ENCERRADA=2
VAGA_STATUS_BLOQUEADAS=2
COLABORADOR_STATUS_ATIVO=1
COLABORADOR_STATUS_INATIVO=0

# Proteção conservadora até o negócio confirmar vínculos simultâneos.
ALLOW_MULTIPLE_ACTIVE_LINKS=false
