# Copie para .env na raiz do monorepo. Nunca commitar o .env.
# Aponte somente para um PostgreSQL local ou de homologação.
# Não coloque aqui a URL, a senha ou o host da base atual.

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54330/dnawork
JWT_SECRET=troque-por-um-segredo-longo-de-pelo-menos-32-caracteres
ADMIN_EMAIL=admin@dnawork.local

# Produção: use apenas o hash. Gere com:
# npm run hash-password -- "sua-senha"
ADMIN_PASSWORD_HASH=

# Desenvolvimento local. Se o hash estiver vazio, esta senha é aceita e
# convertida para Argon2id apenas em memória, no boot.
ADMIN_PASSWORD=altere-esta-senha

PORT=3333
# Em produção o container escuta em 0.0.0.0. Não use o IP do banco aqui.
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Horas que o login dura (padrão 8). No ambiente local pode ser 720 (30 dias).
# SESSAO_HORAS=720

# Códigos confirmados na base atual em 2026-10-21.
# Contratação: 1 ativa (sem data de demissão), 2 encerrada.
# Vaga: 1 passa a ocupada no legado ao contratar; 2 acompanha contratos encerrados.
CONTRATACAO_STATUS_ATIVO=1
CONTRATACAO_STATUS_ENCERRADO=2
VAGA_STATUS_OCUPADA=1
VAGA_STATUS_ENCERRADA=2
VAGA_STATUS_BLOQUEADAS=2
COLABORADOR_STATUS_ATIVO=1
COLABORADOR_STATUS_INATIVO=0

# Proteção conservadora até o negócio confirmar vínculos simultâneos.
ALLOW_MULTIPLE_ACTIVE_LINKS=false

# Produção: CORS_ORIGIN=https://interno.dnawork.ai
# ZapSign. O token fica só no ambiente, nunca no repositório.
# Webhook a cadastrar: https://interno.dnawork.ai/api/v1/zapsign/webhook
ZAPSIGN_API_TOKEN=
ZAPSIGN_API_URL=https://api.zapsign.com.br
ZAPSIGN_USER_TOKEN=
ZAPSIGN_AGENTE_ID=

# PDFs do gerador de TCE. Empresas e escolas vêm do PostgreSQL em DATABASE_URL.
PDF_STORAGE_DIR=./data/tces

# Asaas. A chave fica só no ambiente.
# Webhook: https://interno.dnawork.ai/api/v1/asaas/webhook
ASAAS_API_KEY=
ASAAS_API_URL=https://api.asaas.com
ASAAS_WEBHOOK_TOKEN=

# Portal das empresas, repositório sistema-dna-empresas.
# SERVICE_TOKEN é o mesmo valor nos dois serviços. Header: x-service-token
EMPRESAS_API_URL=https://empresas.dnawork.ai
SERVICE_TOKEN=

# Mailjet. A chave pública e o segredo ficam só no ambiente.
# Remetente dos TCE e documentos: documentos@dnawork.ai
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM=documentos@dnawork.ai
MAILJET_FROM_NAME=DNA Work

# Régua de cobrança. Os dois primeiros ficam em 0 até a autorização de envio.
# O relógio, se ligado, roda às 08:00 em America/Sao_Paulo.
REGUA_ENVIO_REAL=0
REGUA_AGENDA=0
REGUA_INICIO=2026-11-10

# Triagem: horário e bairro da página Operacional do Notion. Sem token, usa só o webhook.
NOTION_TOKEN=
# Sync de vagas abertas + Notion (00h, 06h, 12h e 18h de São Paulo). Sem valor, só liga em produção.
NOTION_SYNC_AUTO=
# 1 = só simula e escreve o log, sem gravar.
NOTION_SYNC_DRY=

# CRM DNA (Bwipo) - origem dos candidatos no Painel, webhooks /api/v1/webhooks/lead-criado e /ganho
# e o Gerador de dossiês da Triagem (busca do negócio pelo telefone).
# Também aceita CRM_BASE_URL=https://integrations.bwipo.com/api e CRM_API_KEY= (mesmos valores, outro nome).
CRM_DNA_API_URL=https://integrations.bwipo.com
CRM_DNA_API_TOKEN=

# LMS dos cursos. O token fica só no ambiente, igual ao do LMS. Sem ele, criar acesso responde 503.
# O aluno criado entra em todos os cursos publicados. POST {LMS_API_URL}/api/integracao/acessos
# Se daqui a chamada a cursos.dnawork.ai cair na página "Service is not reachable", o código tenta o host direto.
LMS_ACCESS_TOKEN=
LMS_API_URL=https://cursos.dnawork.ai

# Triagem inteligente (página /triagem). Opcional: sem estas chaves, a busca rápida funciona igual
# e a busca inteligente mostra "avaliação indisponível". As chaves ficam só no backend.
# Luna: resumo do currículo pela OpenAI (Responses API), mesmo modelo do workflow "resumo cv + match".
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
LUNA_MODEL=gpt-6-luna
LUNA_TIMEOUT_MS=90000
# JEV (TypeSafe): score "compatibilidade_profissional" (escala 0 a 4), a mesma pergunta do nó Jev do n8n.
# Chamada: POST {JEV_API_URL}/v1/systemone com Authorization: Bearer {JEV_API_KEY}.
JEV_API_URL=https://api.typesafe.ai
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=30000
JEV_CONCORRENCIA=3
JEV_LOTE=10
